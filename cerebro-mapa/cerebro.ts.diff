+      }))
+      .then((u) => ({ ...u, porLicao: usoDosEnsinamentosNoLog() }));
+    try { cacheUso = { em: Date.now(), dados: await usoEmAndamento }; } finally { usoEmAndamento = null; }
+  }
+  return cacheUso.dados;
+}
