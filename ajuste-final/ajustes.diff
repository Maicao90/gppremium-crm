+export function aroPedidoSozinho(rajada: string[]): string | null {
+  const t = rajada.map((r) => textoDoCliente(r)).filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();
+  const m = RE_SO_TROCA_ARO.exec(t);
