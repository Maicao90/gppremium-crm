+  const { aro, larguraPerfil, opcoes } = troca;
+  const lista = opcoes.length === 0 ? '' : opcoes.length === 1 ? ` No aro ${aro} eu tenho a ${opcoes[0]}.` : ` No aro ${aro} eu tenho ${opcoes.slice(0, -1).join(', ')} e ${opcoes[opcoes.length - 1]}.`;
