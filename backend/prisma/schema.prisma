// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   String        @id @default(uuid())
  nome                 String
  email                String        @unique @default("")
  senha                String        @default("")
  role                 String        @default("operador") // admin, operador
  ativo                Boolean       @default(true)
  whatsappConectado    Boolean       @default(false)
  autoRespostaAtiva    Boolean       @default(false)
  autoRespostaMensagem String        @default("Oi! Sou a Josi 👋\nPor gentileza me diz seu NOME e a medida de PNEUS que você precisa.\n\nHorário de atendimento:\nSegunda a sexta de 08h às 18h\nSábado de 08h às 12h.")
  assinaturaPainel     String?       // assinatura usada nas mensagens enviadas pelo painel CRM (separada da extensão)
  agendamentos         Agendamento[]
  autoReplyHistories   AutoReplyHistory[]
  criadoEm             DateTime      @default(now())
}

model Agendamento {
  id                    String   @id @default(uuid())
  cliente               String
  numero                String
  mensagem              String
  enviarEm              DateTime
  status                String   @default("pendente") // pendente, enviado, cancelado, falhou, cliente_respondeu
  cancelarSeResponder   Boolean  @default(true)
  observacoes           String?  // Campo para rastrear tentativas de retry e informações de diagnóstico
  
  criadoPorId           String
  criadoPor             Usuario  @relation(fields: [criadoPorId], references: [id])
  
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt
}

model Contato {
  id           String   @id @default(uuid())
  usuarioId    String
  nome         String
  numero       String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Cada contato pertence a um usuário; o mesmo número pode existir para usuários diferentes.
  @@unique([usuarioId, numero])
  @@index([usuarioId])
}

model Configuracao {
  id               String   @id @default("global")
  expedienteAtivo  Boolean  @default(false)
  expedienteInicio String   @default("08:00")
  expedienteFim    String   @default("18:00")
  expedienteDias   String   @default("1,2,3,4,5") // Segunda a Sexta (1,2,3,4,5)
  atualizadoEm     DateTime @updatedAt
}

model AutoReplyHistory {
  id           String   @id @default(uuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  numero       String
  criadoEm     DateTime @default(now())

  @@unique([usuarioId, numero]) // Garante que o mesmo número só receba uma vez por usuário
}

// Caixa de Entrada (pós-venda): histórico de mensagens por sessão/atendente
model Mensagem {
  id         String   @id @default(uuid())
  usuarioId  String   // a sessão/atendente dono da conexão WhatsApp
  chatJid    String   // o contato (ex: 5511999999999@s.whatsapp.net)
  chatNome   String   @default("")
  fromMe     Boolean  @default(false) // true = enviada por nós; false = recebida do cliente
  texto      String   @default("")
  tipo       String   @default("texto") // texto, imagem, video, audio, documento, figurinha, outro
  midiaUrl   String?  // caminho da mídia baixada (ex: /midias/abc.jpg)
  waId       String?  // id da mensagem no WhatsApp
  apagada    Boolean  @default(false) // o contato apagou esta mensagem (mantemos visível, riscada)
  numeroReal String?  // número de telefone REAL do contato (resolvido a partir do @lid)
  timestamp  DateTime @default(now())

  @@index([usuarioId, chatJid])
  @@index([usuarioId])
}

// Mensagens rápidas (templates) usadas na Caixa de Entrada — compartilhadas pela equipe
model Template {
  id        String   @id @default(uuid())
  atalho    String   @default("")
  texto     String
  criadoEm  DateTime @default(now())
}
