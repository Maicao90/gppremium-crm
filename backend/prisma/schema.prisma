// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   String             @id @default(uuid())
  nome                 String
  email                String             @unique @default("")
  senha                String             @default("")
  role                 String             @default("operador") // admin, operador
  ativo                Boolean            @default(true)
  whatsappConectado    Boolean            @default(false)
  // Conexão pausada manualmente (ex.: conta travada pelo WhatsApp aguardando resolução).
  // Persistido no banco porque o Set em memória se perdia a cada restart do servidor,
  // fazendo o vigia reconectar sozinho e gerar QR infinito de novo.
  whatsappPausado      Boolean            @default(false)
  autoRespostaAtiva    Boolean            @default(false)
  autoRespostaMensagem String             @default("Oi! Sou a Josi 👋\nPor gentileza me diz seu NOME e a medida de PNEUS que você precisa.\n\nHorário de atendimento:\nSegunda a sexta de 08h às 18h\nSábado de 08h às 12h.")
  // Bot de vendas com IA. Fica desligado por padrao e usa a sessao Baileys deste usuario.
  botIaAtivo            Boolean            @default(false)
  botIaPausaManualMin   Int                @default(120)
  assinaturaPainel     String? // assinatura usada nas mensagens enviadas pelo painel CRM (separada da extensão)
  // Compartilhamento de conexão WhatsApp: quando preenchido, este Usuario NÃO tem
  // sessão Baileys própria — todas as ações de WhatsApp dele (conectar, enviar, receber)
  // são redirecionadas para a sessão do Usuario "dono" apontado por este ID. Usado quando
  // 2+ atendentes precisam atender pelo MESMO número de WhatsApp (não dá pra ter 2
  // sessões Baileys reais no mesmo número: o WhatsApp trataria como 2 aparelhos
  // vinculados e duplicaria toda mensagem recebida). Campo solto (sem @relation formal),
  // no mesmo estilo de outros campos soltos já existentes (ex.: ContaAnuncio.conexao_id).
  whatsappDonoId       String?
  // Loja (do CRM de Anúncios) a que este atendente pertence — só pra organizar a
  // lista de atendentes por loja no painel. Campo solto (sem @relation), mesmo
  // estilo dos demais campos soltos já existentes.
  lojaId               String?
  // Controle de acesso ao painel: JSON array de ids de modulo permitidos
  // (ex.: ["at-dashboard","at-atendentes","at-inbox"] para um gerente).
  // Roles master/admin ignoram e enxergam tudo. Default "[]" (sem acesso ao painel).
  modulosPermitidos    String             @default("[]")
  // Parceiro externo (fora da equipe GP) que usa só a extensão do WhatsApp, sem conta
  // formal de funcionário. Fica de fora das telas normais (Usuários, seletor de loja da
  // Caixa de Entrada) — só aparece no painel escondido de Parceiros da Extensão.
  externo              Boolean            @default(false)
  // Código que a extensão troca por um token de acesso — dispensa e-mail/senha pro
  // parceiro externo. Só usuário externo tem; nulo pros funcionários normais.
  codigoAtivacao       String?            @unique
  agendamentos         Agendamento[]
  autoReplyHistories   AutoReplyHistory[]
  criadoEm             DateTime           @default(now())
}

// Estado por conversa do bot Baileys. A pausa sobrevive a restart e impede que a IA
// responda por cima de um atendente que assumiu o cliente.
model BotConversa {
  id                 String    @id @default(uuid())
  usuarioId          String
  chatJid            String
  pausadoAte         DateTime?
  ultimoInboundWaId  String?
  ultimaRespostaEm   DateTime?
  motivoPausa        String?
  // Fluxo deterministico de medida/preco (10/09). estadoPreco: sem_estado |
  // aguardando_medida | medida_sem_match | preco_confirmado. dadosPreco e JSON
  // serializado (medida, aroSemMatch) — guarda o que o fluxo ja decidiu, pra nao
  // repetir pergunta nem inventar preco diferente se o cliente perguntar de novo
  // depois. Preco NUNCA fica salvo aqui — e sempre revalidado contra a tabela na
  // hora de responder (evita responder um preco desatualizado ou inventado).
  estadoPreco        String?
  dadosPreco         String?
  atualizadoEm       DateTime  @updatedAt
  criadoEm           DateTime  @default(now())

  @@unique([usuarioId, chatJid])
  @@index([usuarioId, atualizadoEm])
}

model Agendamento {
  id                  String   @id @default(uuid())
  cliente             String
  numero              String
  mensagem            String
  enviarEm            DateTime
  status              String   @default("pendente") // pendente, enviado, cancelado, falhou, cliente_respondeu
  cancelarSeResponder Boolean  @default(true)
  observacoes         String? // Campo para rastrear tentativas de retry e informações de diagnóstico

  // Anexo de mídia (opcional). Sem mídia = mensagem de texto pura (comportamento antigo).
  tipo      String  @default("texto") // texto, imagem, video, audio, documento
  midiaUrl  String? // caminho no disco, ex: /midias/agendamentos/<uuid>.jpg
  midiaNome String? // nome original do arquivo (pra documento exibir certo)

  criadoPorId String
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Contato {
  id           String   @id @default(uuid())
  usuarioId    String
  nome         String
  numero       String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Cada contato pertence a um usuário; o mesmo número pode existir para usuários diferentes.
  @@unique([usuarioId, numero])
  @@index([usuarioId])
}

model Configuracao {
  id               String   @id @default("global")
  expedienteAtivo  Boolean  @default(false)
  expedienteInicio String   @default("08:00")
  expedienteFim    String   @default("18:00")
  expedienteDias   String   @default("1,2,3,4,5") // Segunda a Sexta (1,2,3,4,5)
  atualizadoEm     DateTime @updatedAt
}

model AutoReplyHistory {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  numero    String
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, numero]) // Garante que o mesmo número só receba uma vez por usuário
}

// Caixa de Entrada (pós-venda): histórico de mensagens por sessão/atendente
model Mensagem {
  id           String   @id @default(uuid())
  usuarioId    String // a sessão/atendente dono da conexão WhatsApp
  chatJid      String // o contato (ex: 5511999999999@s.whatsapp.net)
  chatNome     String   @default("")
  fromMe       Boolean  @default(false) // true = enviada por nós; false = recebida do cliente
  texto        String   @default("")
  tipo         String   @default("texto") // texto, imagem, video, audio, documento, figurinha, outro
  midiaUrl     String? // caminho da mídia baixada (ex: /midias/abc.jpg)
  waId         String? // id da mensagem no WhatsApp
  apagada      Boolean  @default(false) // o contato apagou esta mensagem (mantemos visível, riscada)
  numeroReal   String? // número de telefone REAL do contato (resolvido a partir do @lid)
  // Quando a conexão é COMPARTILHADA entre atendentes, registra QUAL atendente (entre os
  // que compartilham o número) efetivamente mandou esta mensagem manual pela Caixa de
  // Entrada. Null quando não aplicável (conexão não compartilhada, ou mensagem recebida
  // do cliente). `usuarioId` acima continua sendo sempre o DONO da conexão real.
  enviadoPorId String?
  timestamp    DateTime @default(now())

  @@index([usuarioId, chatJid])
  @@index([usuarioId])
}

// Mensagens rápidas (templates) usadas na Caixa de Entrada — compartilhadas pela equipe
model Template {
  id       String   @id @default(uuid())
  atalho   String   @default("")
  texto    String
  criadoEm DateTime @default(now())
}

// ── CRM de ANÚNCIOS (antes mock/localStorage; agora persiste no mesmo banco) ──
model Empresa {
  id         String     @id @default(uuid())
  name       String     @default("")
  segment    String     @default("")
  notes      String     @default("")
  created_at DateTime   @default(now())
  lojas      Loja[]
  campanhas  Campanha[]
}

model Loja {
  id                  String     @id @default(uuid())
  company_id          String
  empresa             Empresa    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  store_name          String     @default("")
  city                String     @default("")
  state               String     @default("")
  whatsapp            String     @default("")
  telefone_fixo       String     @default("")
  site                String     @default("")
  instagram           String     @default("")
  manager_name        String     @default("")
  notes               String     @default("")
  // Loja credenciada no programa Garantia 50k: só credenciada (ou master) pode
  // cadastrar garantia e fazer revisão. Ligado/desligado por loja na tela de Lojas.
  credenciadaGarantia Boolean    @default(false)
  created_at          DateTime   @default(now())
  campanhas           Campanha[]
}

model Campanha {
  id           String   @id @default(uuid())
  company_id   String
  empresa      Empresa  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  store_id     String?
  loja         Loja?    @relation(fields: [store_id], references: [id], onDelete: SetNull)
  name         String   @default("")
  platform     String   @default("Meta")
  status       String   @default("Active")
  spend        Float    @default(0)
  leads        Int      @default(0)
  daily_budget Float?
  keywords     String?
  created_at   DateTime @default(now())
  // Vínculo com a integração de anúncios (Google/Meta). Nulos = campanha criada manualmente.
  external_id  String? // id da campanha na plataforma externa
  conexao_id   String? // id da ConexaoAds que sincronizou esta campanha

  @@index([company_id])
}

// ── Integrações de Anúncios (Google Ads / Meta Ads) ──
// Guarda as credenciais de cada conta conectada. O campo `credenciais` é um JSON
// serializado (chaves variam por plataforma) e NUNCA deve ser devolvido completo pela API.
model ConexaoAds {
  id          String    @id @default(uuid())
  plataforma  String    @default("google") // google | meta
  nome        String    @default("")
  company_id  String    @default("")
  store_id    String?
  credenciais String    @default("{}") // JSON serializado com as credenciais da plataforma
  ativo       Boolean   @default(true)
  ultimaSync  DateTime? // última sincronização bem-sucedida
  ultimoErro  String? // último erro de sincronização (null = tudo ok)
  criadoEm    DateTime  @default(now())
}

// Log de auditoria do Otimizador de Google Ads: 1 linha por ação REALMENTE
// aplicada (aprovada manualmente no painel). Nunca guarda sugestões pendentes —
// a auditoria/análise é recalculada ao vivo a cada visita à tela.
model OtimizacaoExecucao {
  id           String   @id @default(uuid())
  conexaoId    String
  operacao     String // pause_keyword | add_negative
  entidadeNome String   @default("")
  acaoResumo   String   @default("")
  parametros   String   @default("{}") // JSON
  sucesso      Boolean  @default(false)
  resultado    String   @default("{}") // JSON (resposta da API ou erro)
  criadoEm     DateTime @default(now())

  @@index([conexaoId])
}

// Métricas por campanha POR DIA, vindas das plataformas de anúncio.
// A unique (conexaoId + campanhaExternalId + data) permite re-sincronizar sem duplicar.
model MetricaDiaria {
  id                 String   @id @default(uuid())
  conexaoId          String
  campanhaExternalId String // id da campanha na plataforma (Google/Meta)
  campanhaNome       String   @default("")
  plataforma         String   @default("")
  data               DateTime // dia da métrica (meia-noite UTC)
  spend              Float    @default(0)
  leads              Int      @default(0)
  impressoes         Int      @default(0)
  cliques            Int      @default(0)

  @@unique([conexaoId, campanhaExternalId, data])
  @@index([conexaoId])
}

// ── Link na Bio (página pública estilo Linktree por Loja) ──
// 1 PaginaLink por Loja (loja_id único). Servida via subdomínio próprio da loja
// (ex.: link.pneusgppremium.com.br), interceptado por hostname no server.ts ANTES
// do express.static — ver middleware paginaLinkPublica.
model PaginaLink {
  id             String   @id @default(uuid())
  loja_id        String   @unique // 1 pagina por loja
  subdominio     String?  @unique // ex.: "link.pneusgppremium.com.br" (host exato que vai bater na requisicao). Null = ainda nao publicada/sem dominio configurado.
  titulo         String   @default("")
  bio            String   @default("")
  fotoUrl        String? // logo/avatar, so URL (sem upload de arquivo por enquanto)
  imagemFundoUrl String? // imagem de fundo da pagina, so URL. Se null, usa corFundo (cor solida).
  corFundo       String   @default("#0d1122")
  corBotao       String   @default("#e8252c")
  corTexto       String   @default("#ffffff")
  formato        String   @default("arredondado") // arredondado | quadrado | pill
  links          String   @default("[]") // JSON: [{ id, label, url, icone, ordem }]
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
}

model ContaAnuncio {
  id             String   @id @default(uuid())
  nome           String   @default("")
  plataforma     String   @default("google")
  saldo          Float    @default(0)
  gastoDia       Float    @default(0)
  gastoMes       Float    @default(0)
  depositoMes    Float    @default(0)
  limiteAlerta   Float    @default(0)
  ultimoDepValor Float    @default(0)
  ultimoDepData  String   @default("")
  created_at     DateTime @default(now())
  // Vínculo com a ConexaoAds que alimenta esta conta automaticamente (saldo/gasto do dia).
  // Null = conta gerenciada manualmente na tela "Saldos das Contas".
  // @unique (04/09): sem isso, duas linhas podiam apontar pro mesmo conexao_id — o sync
  // usava findFirst() e atualizava sempre a mesma linha ao acaso, deixando a outra com
  // dado antigo/errado (achado real: 6 linhas "Google Ads" mostravam saldo do META,
  // porque compartilhavam o conexao_id da conexao Meta daquela loja).
  conexao_id     String? @unique
}

// Histórico de depósitos de uma ContaAnuncio. Cada "Registrar depósito" no painel vira
// UM registro aqui (não sobrescreve mais nada) — permite somar quanto entrou em cada
// mês por conta. ultimoDepValor/ultimoDepData em ContaAnuncio continuam existindo (o
// depósito mais recente, calculado a partir daqui) só pra não quebrar quem já lia isso.
model Deposito {
  id       String   @id @default(uuid())
  contaId  String
  valor    Float
  data     String // YYYY-MM-DD
  criadoEm DateTime @default(now())
}

// Lista de clientes de uma campanha de disparo MANUAL de WhatsApp (o atendente clica,
// o WhatsApp abre com a mensagem pronta, ele confere e aperta enviar — nada é enviado
// sozinho, pra não arriscar bloqueio do número). Hoje só a Direcional Pneus usa isso
// (importado de uma ferramenta avulsa que existia fora do CRM).
model DisparoContato {
  id           String    @id @default(uuid())
  storeId      String
  nome         String
  tel          String    @default("") // só dígitos com DDI; "" = sem telefone válido
  telDisp      String    @default("") // formatado, pra exibir
  segmento     String    @default("")
  valor        Float     @default(0) // valor já gasto pelo cliente (LTV) — pra priorizar
  servicos     String    @default("")
  verificar    Boolean   @default(false) // telefone com formato estranho, conferir antes
  mensagemBase String    @default("") // texto pronto do disparo (sem placeholder de desconto)
  contatado    Boolean   @default(false)
  contatadoEm  DateTime? // última vez que "contatado" virou true (checkbox OU botão)
  enviadoEm    DateTime? // só quando o botão "Abrir WhatsApp" foi clicado — conta pro limite diário
  // QUEM disparou (Usuario.id). A lista de contatos é compartilhada pela loja toda, mas
  // o dono quer ver quanto cada atendente fez — sem isso, só dava pra contar o total.
  // Campo solto (sem @relation), mesmo estilo dos outros campos soltos do schema.
  enviadoPorId String?
  criadoEm     DateTime  @default(now())
}

// ── Módulo OLX: Anúncios, Monitor de Status e Chat Integrado ──

model OlxConta {
  id              String       @id @default(uuid())
  nome            String       @default("") // Ex: "OLX - Feirão dos Pneus"
  email           String       @default("")
  lojaId          String? // Loja associada no CRM
  companyId       String?
  clientId        String? // Credenciais da API da OLX (se houver)
  clientSecret    String?
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  statusConexao   String       @default("ativo") // ativo, desconectado, erro
  ultimoErro      String?
  anuncios        OlxAnuncio[]
  conversas       OlxConversa[]
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
}

model OlxAnuncio {
  id              String        @id @default(uuid())
  contaId         String?
  conta           OlxConta?     @relation(fields: [contaId], references: [id], onDelete: SetNull)
  lojaId          String? // Loja associada
  olxAdId         String? // ID do anúncio na OLX (ex: "123456789")
  titulo          String
  descricao       String        @default("")
  preco           Float         @default(0)
  categoria       String        @default("pneus_rodas") // pneus_rodas, pecas_autos, servicos, outro
  tipoItem        String        @default("novo") // novo, usado
  fotos           String        @default("[]") // JSON array de URLs das fotos
  cep             String        @default("")
  telefone        String        @default("")
  linkOlx         String? // URL pública do anúncio na OLX
  status          String        @default("ativo") // ativo, inativo, pendente, expirado, removido
  motivoRemocao   String? // Motivo detectado (ex: "Anúncio expirou", "Removido pela moderação", "Link 404")
  visualizacoes   Int           @default(0)
  chatsTotal      Int           @default(0)
  publicadoEm     DateTime?
  expiraEm        DateTime?
  ultimaChecagem  DateTime?     @default(now())
  conversas       OlxConversa[]
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  @@index([lojaId])
  @@index([status])
}

model OlxConversa {
  id              String        @id @default(uuid())
  contaId         String?
  conta           OlxConta?     @relation(fields: [contaId], references: [id], onDelete: SetNull)
  anuncioId       String?
  anuncio         OlxAnuncio?   @relation(fields: [anuncioId], references: [id], onDelete: SetNull)
  olxChatId       String? // ID do chat na OLX
  compradorNome   String        @default("Interessado OLX")
  compradorId     String?
  ultimaMsg       String        @default("")
  ultimaMsgData   DateTime      @default(now())
  naoLidas        Int           @default(0)
  atendenteId     String? // Último atendente que respondeu
  mensagens       OlxMensagem[]
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  @@index([contaId])
  @@index([anuncioId])
}

model OlxMensagem {
  id           String      @id @default(uuid())
  conversaId   String
  conversa     OlxConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  olxMsgId     String?
  fromMe       Boolean     @default(false) // true = nossa resposta; false = mensagem do comprador
  texto        String      @default("")
  midiaUrl     String?
  tipo         String      @default("texto") // texto, imagem, documento
  enviadoPorId String? // ID do atendente logado no CRM que mandou a resposta
  timestamp    DateTime    @default(now())

  @@index([conversaId])
}

// Configuração da CAMPANHA de disparo de cada loja: a arte que vai junto do texto e o
// teto de envios por dia. Antes a foto vivia só na memória da aba (sumia ao recarregar,
// e cada operador tinha que anexar de novo) e o limite diário só existia no navegador —
// duas abas abertas furavam o teto sem o servidor perceber.
model DisparoCampanha {
  id              String    @id @default(uuid())
  storeId         String    @unique
  fotoUrl         String? // arte enviada junto do texto (em /midias/disparo/)
  fotoNome        String? // nome do arquivo original, só pra exibir no painel
  limiteDia       Int       @default(30) // teto de envios por dia (ex: 30 por dia)
  autoDisparo     Boolean   @default(true) // automação ativa
  horaInicio      String    @default("08:00") // início da janela diária de disparo (08:00)
  horaFim         String    @default("17:00") // fim da janela diária de disparo (17:00)
  mensagemPadrao  String?   // template de mensagem padrão para novos envios
  ultimoDisparoEm DateTime? // registro do último disparo automático enviado
  atualizadoEm    DateTime  @updatedAt
  criadoEm        DateTime  @default(now())
}

// ===== Garantia 50.000 KM (módulo "aplicativo", importado do protótipo GPPREMIUMGARANTIA50K) =====
// Fluxo: loja vende pneus → ativa a garantia pro cliente (nasce "pendente") → admin
// audita e aprova/reprova → revisões periódicas registram sulcos e problemas por pneu.
// Regras de negócio fixas: kmMaximo = kmInicial + 50000; dataExpiracao = início + 2 anos.

model GarantiaCliente {
  id         String   @id @default(uuid())
  nome       String
  cpf        String   @unique // só dígitos (11)
  telefone   String   @default("")
  email      String   @default("")
  nascimento String   @default("") // YYYY-MM-DD ou "" (pra campanha de aniversário no futuro)
  // Login do CLIENTE no app (CPF + senha). Vazio = cliente cadastrado pela loja que
  // ainda não criou senha no app; ele cria no primeiro acesso.
  senha      String   @default("") // hash bcrypt
  // Token de push do Expo (aparelho do cliente) — pra notificação na tela do celular.
  pushToken  String   @default("")
  criadoEm   DateTime @default(now())
}

model GarantiaVeiculo {
  id                 String   @id @default(uuid())
  clienteId          String
  placa              String   @unique // maiúsculas sem hífen (Mercosul ou padrão antigo)
  marca              String   @default("")
  modelo             String   @default("")
  ano                Int      @default(0)
  kmAtual            Int      @default(0) // atualizado a cada revisão
  fotoUrl            String? // foto geral do veículo (em /midias/garantia/)
  fotoOdometroUrl    String?
  // Etiqueta de troca de óleo — base do cálculo de km/dia (motor de notificação).
  // Se o veículo não tem etiqueta, semEtiquetaOleo=true e a próxima revisão é agendada
  // pelo mesmo nº de dias da revisão anterior (regra do plano).
  oleoData           String   @default("") // YYYY-MM-DD da última troca de óleo
  oleoKm             Int      @default(0) // km do carro na última troca de óleo
  oleoProximaTrocaKm Int? // km que a PRÓPRIA ETIQUETA indica pra próxima troca (lido do adesivo, não calculado)
  semEtiquetaOleo    Boolean  @default(false)
  etiquetaOleoUrl    String? // foto da etiqueta de óleo
  kmPorDia           Float    @default(0) // média calculada (recalculada a cada revisão)
  criadoEm           DateTime @default(now())
}

model Garantia {
  id                      String   @id @default(uuid())
  clienteId               String
  veiculoId               String
  status                  String   @default("pendente") // pendente, em_analise, ativa, atencao, reprovada, cancelada, expirada
  kmInicial               Int
  kmMaximo                Int // kmInicial + 50000
  dataInicio              String // YYYY-MM-DD
  dataExpiracao           String // dataInicio + 2 anos
  // Cópia imutável dos dados/fotos da ativação. O veículo recebe dados novos nas
  // revisões, então o primeiro cadastro precisa do próprio registro histórico.
  cadastroOleoData        String   @default("")
  cadastroOleoKm          Int      @default(0)
  cadastroFotoVeiculoUrl  String?
  cadastroFotoOdometroUrl String?
  cadastroEtiquetaOleoUrl String?
  dotDivergente           Boolean  @default(false) // alguma revisão leu um DOT diferente do cadastrado
  criadoPorId             String? // Usuario do painel que ativou (campo solto, padrão do projeto)
  lojaId                  String? // loja credenciada que VENDEU/ativou (escopo: a loja só vê as suas). Null = master
  criadoEm                DateTime @default(now())
  atualizadoEm            DateTime @updatedAt
}

model GarantiaPneu {
  id              String    @id @default(uuid())
  garantiaId      String
  posicao         String // dianteiro_esquerdo, dianteiro_direito, traseiro_esquerdo, traseiro_direito, estepe
  marca           String    @default("")
  modelo          String    @default("")
  medida          String    @default("") // ex.: 205/55 R16
  dot             String    @default("") // 4 dígitos (semana+ano de fabricação)
  codigoSerie     String    @default("")
  etiquetaNumero  String    @default("") // nº da etiqueta do pneu (rastreio)
  fotoUrl         String? // foto principal (etiqueta)
  fotoLateralUrl  String?
  fotoBandaUrl    String?
  // Garantia DESTE pneu cancelada (ex.: arrancamento de borracha detectado numa revisão).
  // Pneu cancelado não aceita mais revisão e o cliente é notificado.
  cancelada       Boolean   @default(false)
  canceladaMotivo String    @default("")
  canceladaEm     DateTime?
  criadoEm        DateTime  @default(now())
}

model GarantiaRevisao {
  id               String   @id @default(uuid())
  garantiaId       String
  km               Int
  // KM que deveria ter sido feita a revisão (última revisão/ativação + intervaloRevisaoKm
  // da config, calculado no momento do registro) — usado pra auditoria e pro auto-reprovar.
  kmEsperado       Int?
  status           String   @default("pendente") // pendente, aprovada, reprovada
  mecanico         String   @default("") // nome livre — mecânico de pista não tem login no painel
  observacoes      String   @default("")
  fotoOdometroUrl  String?
  etiquetaOleoUrl  String? // foto da etiqueta de óleo na revisão
  oleoData         String   @default("") // data lida na etiqueta desta revisão
  oleoKm           Int      @default(0) // km lido na etiqueta desta revisão
  // Odômetro suspeito: o km informado é MENOR que o da revisão/ativação anterior
  // (odômetro andou pra trás = possível adulteração) → alerta pro analista.
  odometroSuspeito Boolean  @default(false)
  criadoPorId      String? // Usuario do painel que registrou
  lojaId           String? // loja credenciada que FEZ a revisão (pode ser diferente da que vendeu)
  criadoEm         DateTime @default(now())
}

model GarantiaRevisaoPneu {
  id                     String   @id @default(uuid())
  revisaoId              String
  pneuId                 String? // GarantiaPneu correspondente (null se a posição não bateu com nenhum)
  posicao                String
  // Profundidade do sulco (menor medida), campo selecionável 1.6–10.0 (regra do plano).
  profundidadeSulco      Float    @default(0)
  sulcoExterno           Float    @default(0) // mm (detalhe opcional)
  sulcoCentral           Float    @default(0)
  sulcoInterno           Float    @default(0)
  estado                 String   @default("bom") // excelente, bom, regular, ruim, trocar
  // Flag de FRAUDE: marcas de tração/arrancamento de pedaços de borracha na banda.
  // Marcada → cancela a garantia DESTE pneu automaticamente (regra do plano).
  arrancamentoBorracha   Boolean  @default(false)
  problemas              String   @default("[]") // JSON array de outros problemas
  dotLido                String   @default("") // DOT visto na hora (comparado com o cadastrado)
  observacoes            String   @default("")
  recomendacao           String   @default("")
  // Etiqueta INTERNA do pneu — só obrigatória na 1ª revisão de CADA pneu (o pneu não
  // muda de identidade entre revisões, então documentar de novo toda vez é redundante).
  // "1ª revisão desse pneu" é calculado no backend: nunca apareceu antes num
  // GarantiaRevisaoPneu com esse pneuId → é a primeira.
  fotoEtiquetaInternaUrl String?
  fotoDotUrl             String? // DOT junto com o pneu — obrigatória em TODA revisão
  fotoBandaDireitaUrl    String? // banda de rodagem perto do ombro direito, com o profundímetro no pneu — TODA revisão
  fotoBandaEsquerdaUrl   String? // banda de rodagem perto do ombro esquerdo, com o profundímetro no pneu — TODA revisão
  criadoEm               DateTime @default(now())
}

// Config do módulo (singleton id="global"). Os números do plano são configuráveis
// porque a planilha se contradiz (1 vs 2 anos; 5.000 vs 10.000 km) — o master ajusta
// pelo painel sem mexer no código.
model GarantiaConfig {
  id                 String   @id @default("global")
  garantiaMeses      Int      @default(24) // duração da garantia (meses)
  garantiaKm         Int      @default(50000) // durabilidade (km)
  intervaloRevisaoKm Int      @default(10000) // revisão a cada X km
  atualizadoEm       DateTime @updatedAt
}

// Notificações ao cliente (motor de km/dia). São AGENDADAS (agendadaPara) e o painel
// mostra as devidas do dia pra envio manual (mesma filosofia do Disparo — nada é
// enviado sozinho, pra não arriscar bloqueio do WhatsApp).
model GarantiaNotificacao {
  id           String    @id @default(uuid())
  clienteId    String
  garantiaId   String
  tipo         String // revisao_proxima, pneu_cancelado, garantia_expira, odometro_suspeito
  mensagem     String
  agendadaPara String // YYYY-MM-DD (dia em que deve ser enviada)
  enviada      Boolean   @default(false)
  enviadaEm    DateTime?
  lidaNoApp    Boolean   @default(false)
  lidaNoAppEm  DateTime?
  criadoEm     DateTime  @default(now())
}

// Sorteio entre clientes com garantia ATIVA (Fisher-Yates com crypto — auditável, sem Math.random).
model GarantiaSorteio {
  id          String   @id @default(uuid())
  titulo      String
  vencedores  String   @default("[]") // JSON [{clienteId, nome, cpf, placa}]
  criadoPorId String?
  criadoEm    DateTime @default(now())
}

// Respostas do fluxo de atendimento editadas pelo dono (tela "Fluxo" do painel).
// Guarda so a DIFERENCA do texto padrao (ver src/data/fluxoCatalogo.ts); sem linha = padrao.
model FluxoResposta {
  chave         String   @id
  partes        String   // JSON: array de bolhas de WhatsApp
  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt
}
