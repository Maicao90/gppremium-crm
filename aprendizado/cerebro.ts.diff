+// Aprovar (com ou sem audio) ou ignorar uma proposta. Devolve [status http, corpo].
+function decidirProposta(id: string, corpo: any, u: Usuario): [number, Record<string, unknown>] {
+  const { existe, dados } = lerAprendizado();
