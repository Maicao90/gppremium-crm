{
  "expo": {
    "name": "GPPREMIUM",
    "slug": "gp-premium-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "bundleIdentifier": "com.gppremium.garantia",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "O app usa a câmera para fotografar o odômetro, os pneus e a etiqueta de óleo na garantia e nas revisões.",
        "NSPhotoLibraryUsageDescription": "O app acessa suas fotos para anexar comprovantes na garantia e nas revisões."
      }
    },
    "android": {
      "package": "com.gppremium.garantia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 8
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O app usa a câmera para fotografar odômetro, pneus e etiqueta de óleo."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "gppremium",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7eca4298-d137-4034-a9d5-6c8c879d92be"
      }
    },
    "owner": "madrazo017"
  }
}
